{
  "name": "eisdealer",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "scrape": "bun run packages/scraper/src/index.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/scraper/tsconfig.json",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@plausible-analytics/tracker": "0.4.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
